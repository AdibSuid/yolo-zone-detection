# ==========================================
# YOLO Zone Detection - Git Ignore
# ==========================================

# Python
# ------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
# -------------------
venv/
ENV/
env/
.venv
env.bak/
venv.bak/

# IDE & Editors
# -------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.code-workspace

# YOLO Models
# -----------
# PyTorch model files (download/train separately)
*.pt

# OpenVINO exported models (generated by scripts/export.py)
*_openvino_model/
!best_openvino_model/metadata.yaml

# Other model formats
*.xml
*.bin
*.onnx
*.torchscript
*.mlmodel
*.tflite
*.edgetpu
*.pb

# Test Outputs
# ------------
runs/
output/
*.jpg
*.png
*.mp4
*.avi
test_videos/

# Logs
# ----
*.log
logs/
mqtt-broker/mosquitto/log/*.log

# MQTT Broker Data
# ----------------
mqtt-broker/mosquitto/data/*
!mqtt-broker/mosquitto/data/.gitkeep

# Configuration
# -------------
# Personal camera configuration (keep template file)
cameras_config.json
.env

# OS
# --
Thumbs.db
.DS_Store
*.swp
.AppleDouble
.LSOverride

# Jupyter
# -------
.ipynb_checkpoints/
*.ipynb

# Coverage
# --------
.coverage
htmlcov/
.pytest_cache/

# Type Checking
# -------------
.mypy_cache/
.dmypy.json
dmypy.json

# Keep Important Files
# --------------------
!.gitignore
!README.md
!LICENSE
!requirements.txt
!cameras_config_examples.json
!best_openvino_model/metadata.yaml